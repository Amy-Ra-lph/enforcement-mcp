[41.56, "o", "\u001b[1;36m# Structured fields let AI agents triage denials without parsing audit logs\u001b[0m\r\n"]
[44.06, "o", "\u001b[1;36m# Supports time windows: '1h', '24h', 'recent', 'today', or absolute timestamps\u001b[0m\r\n"]
