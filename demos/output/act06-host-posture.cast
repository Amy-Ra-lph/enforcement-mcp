[35.73, "o", "{\r\n"]
[35.75, "o", "  \"selinux\": {\r\n"]
[35.77, "o", "    \"mode\": \"enforcing\",\r\n"]
[35.79, "o", "    \"policy_type\": \"targeted\",\r\n"]
[35.81, "o", "    \"denial_count_24h\": 0,\r\n"]
[35.83, "o", "    \"top_denied_types\": [],\r\n"]
[35.85, "o", "    \"custom_modules\": [\"abrt\", \"accountsd\", \"acct\", \"apache\", \"auditadm\",\r\n"]
[35.87, "o", "                       \"authlogin\", \"automount\", \"avahi\", \"base\", \"bind\"]\r\n"]
[35.89, "o", "  },\r\n"]
[35.91, "o", "  \"fapolicyd\": {\r\n"]
[35.93, "o", "    \"installed\": false\r\n"]
[35.95, "o", "  },\r\n"]
[35.97, "o", "  \"mls\": {\r\n"]
[35.99, "o", "    \"policy_type\": \"targeted\",\r\n"]
[36.01, "o", "    \"sensitivities\": [\"s0\"],\r\n"]
[36.03, "o", "    \"category_count\": 1024\r\n"]
[36.05, "o", "  },\r\n"]
[36.07, "o", "  \"packages\": {\r\n"]
[36.09, "o", "    \"setools-console\": \"4.6.0-3.el10\",\r\n"]
[36.11, "o", "    \"selinux-policy\": \"42.1.18-4.el10_2\"\r\n"]
[36.13, "o", "  },\r\n"]
[36.15, "o", "  \"os\": \"Red Hat Enterprise Linux release 10.2 (Coughlan)\"\r\n"]
[36.17, "o", "}\r\n"]
[36.19, "o", "\r\n"]
[40.21, "o", "\u001b[1;36m# Aggregates SELinux + fapolicyd + MLS + package versions in one call\u001b[0m\r\n"]
[42.21, "o", "\u001b[1;36m# Too opinionated for linux-mcp upstream \u2014 stays in enforcement-mcp\u001b[0m\r\n"]
