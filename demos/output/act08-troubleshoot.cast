[29.97, "o", "{\r\n"]
[29.99, "o", "  \"symptom\": \"httpd cannot read files in /home\",\r\n"]
[30.01, "o", "  \"root_cause\": \"not_enforcement\",\r\n"]
[30.03, "o", "  \"confidence\": \"high\",\r\n"]
[30.05, "o", "  \"chain\": [\r\n"]
[30.07, "o", "    {\"step\": \"SELinux mode\", \"finding\": \"enforcing\"},\r\n"]
[30.09, "o", "    {\"step\": \"AVC denials for httpd\", \"finding\": \"none\"}\r\n"]
[30.11, "o", "  ],\r\n"]
[30.13, "o", "  \"denials_found\": [],\r\n"]
[30.15, "o", "  \"not_the_cause\": [\r\n"]
[30.17, "o", "    {\"subsystem\": \"selinux\", \"reason\": \"No AVC denials for httpd\"},\r\n"]
[30.19, "o", "    {\"subsystem\": \"fapolicyd\", \"reason\": \"fapolicyd not installed\"}\r\n"]
[30.21, "o", "  ],\r\n"]
[30.23, "o", "  \"suggestion\": \"No enforcement denials found. Check file permissions or service config.\"\r\n"]
[30.25, "o", "}\r\n"]
[30.27, "o", "\r\n"]
[34.29, "o", "\u001b[1;36m# Walks SELinux \u2192 fapolicyd \u2192 MLS automatically. Returns confidence level.\u001b[0m\r\n"]
[36.29, "o", "\u001b[1;36m# Negative results matter: 'not_the_cause' prevents AI agent from chasing ghosts\u001b[0m\r\n"]
[38.79, "o", "\u001b[1;36m# Composite analysis \u2014 standalone enforcement-mcp tool\u001b[0m\r\n"]
