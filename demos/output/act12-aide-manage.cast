[68.79, "o", "# linux-mcp (read-only only):\r\n"]
[68.81, "o", "from enforcement_mcp.modules.selinux import register_readonly_tools\r\n"]
[68.83, "o", "from enforcement_mcp.modules.aide import register_readonly_tools\r\n"]
[68.85, "o", "register_readonly_tools(mcp, ssh_provider)\r\n"]
[68.87, "o", "\r\n"]
[68.89, "o", "# enforcement-mcp (everything):\r\n"]
[68.91, "o", "from enforcement_mcp.modules import register_all_modules\r\n"]
[68.93, "o", "register_all_modules(mcp, ssh_provider)\r\n"]
[68.95, "o", "\r\n"]
[68.97, "o", "# Custom MCP (cherry-pick):\r\n"]
[68.99, "o", "from enforcement_mcp.modules.aide import register_all\r\n"]
[69.01, "o", "register_all(mcp, ssh_provider)  # AIDE everything\r\n"]
[69.03, "o", "\r\n"]
[73.05, "o", "\u001b[1;36m# 4 modules: SELinux, fapolicyd, MLS, AIDE. Each independently consumable.\u001b[0m\r\n"]
[75.55, "m", "End of Arcade"]
