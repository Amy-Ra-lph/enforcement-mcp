[57.62, "o", "# Remediation: Relabel /home/user/public_html to expected context\r\n"]
[57.64, "o", "# Risk: low (0/100) \u2014 proceed\r\n"]
[57.66, "o", "# Generated by enforcement-mcp \u2014 review before applying\r\n"]
[57.68, "o", "---\r\n"]
[57.7, "o", "- name: Relabel /home/user/public_html for httpd_t access\r\n"]
[57.72, "o", "  hosts: '{{ target_hosts }}'\r\n"]
[57.74, "o", "  become: true\r\n"]
[57.76, "o", "  roles:\r\n"]
[57.78, "o", "  - role: fedora.linux_system_roles.selinux\r\n"]
[57.8, "o", "    vars:\r\n"]
[57.82, "o", "      selinux_restore_dirs:\r\n"]
[57.84, "o", "      - /home/user/public_html\r\n"]
